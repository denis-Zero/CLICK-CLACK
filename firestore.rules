rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /produtos/{id} { allow read: if true; allow write: if isAdmin(); }
    match /config/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /admins/{uid}  {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome','email','criado']);
    }
    match /pedidos/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','email','itens','total','criado'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.itens is list
        && request.resource.data.itens.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.criado == request.time;
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if false;
    }
  }
}
